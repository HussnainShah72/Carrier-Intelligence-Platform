# =============================================================================
# Career Intelligence Platform - backend configuration
# =============================================================================
# Copy this file to `.env` in the SAME folder (backend/.env) and edit it:
#
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows cmd)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# The app runs with ZERO changes to this file: the defaults use a local Ollama
# model, so nothing is sent to any cloud service and no API key is needed.
#
# NEVER commit your real `.env`. It is already in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# LANGUAGE MODEL
# -----------------------------------------------------------------------------
# LLM_PROVIDER options:
#
#   ollama     (default) A model running locally via Ollama. Nothing leaves your
#              machine. Install from https://ollama.com then:
#                  ollama pull qwen2.5:3b-instruct-q4_K_M
#                  ollama pull llama3.2:3b
#
#   offline    No language model at all. A deterministic, rule-based engine runs
#              instead so every screen still works. Quality is visibly lower and
#              the UI says so. This is what the unit tests use.
#
#   anthropic  Claude API        - needs ANTHROPIC_API_KEY
#   openai     OpenAI API        - needs OPENAI_API_KEY
#   gemini     Google Gemini API - needs GEMINI_API_KEY
#   groq       Groq API          - needs GROQ_API_KEY. Per-call latency is
#              excellent (measured first-token times of 250-800 ms, roughly
#              3-8x faster than a local 3B model), but the FREE tier is capped
#              at 8,000 tokens per minute and 1,000 requests per day (both read
#              from Groq's own x-ratelimit headers). One interview turn costs
#              about 2,350 tokens -- a measured 1,837 of input, because the
#              conversation history is resent and grows every turn, plus the
#              512-token output ceiling the reasoning models need. The free
#              tier therefore sustains only about 3.4 turns per minute: one
#              turn every 18 seconds. A human-paced interview fits
#              inside that; a back-to-back automated run does not -- it is
#              throttled with HTTP 429 and the retry backoff turns a 500 ms
#              reply into an 18 SECOND one. Fine for interactive use, not for
#              running the evaluation harness. Models used:
#                  LLM_MODEL=openai/gpt-oss-120b
#                  LLM_FAST_MODEL=openai/gpt-oss-20b
#              Note these models emit reasoning tokens that count against
#              max_tokens, which is handled in services/llm/client.py.
#
LLM_PROVIDER=ollama

# Main model: used for CV parsing, role skills, gap advice, CV rewriting, scoring.
# Leave blank to use the provider's default.
LLM_MODEL=

# Fast model: used ONLY for the live interview turn, where latency matters more
# than depth. Leave blank to use the provider's default fast model.
LLM_FAST_MODEL=

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_SECONDS=90

# --- API keys (only the one matching LLM_PROVIDER is needed) ------------------
# Leave blank unless you are using that provider. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Where the local Ollama server is listening.
OLLAMA_BASE_URL=http://127.0.0.1:11434


# -----------------------------------------------------------------------------
# LOCAL SPEECH RECOGNITION  (Module 5 - must run on this machine)
# -----------------------------------------------------------------------------
STT_ENABLED=true

# tiny.en   ~75 MB   fastest, least accurate
# base.en  ~145 MB   the default: good balance on a normal laptop
# small.en ~480 MB   more accurate, noticeably slower on CPU
STT_MODEL_SIZE=base.en

# cpu, or cuda if you have an NVIDIA GPU with CUDA installed.
STT_DEVICE=cpu

# int8 on CPU; use float16 with cuda.
STT_COMPUTE_TYPE=int8

# 1 = greedy decoding (fastest). 5 = more accurate, roughly 2-3x slower.
STT_BEAM_SIZE=1
STT_LANGUAGE=en


# -----------------------------------------------------------------------------
# LOCAL TEXT-TO-SPEECH  (Module 5 - must run on this machine)
# -----------------------------------------------------------------------------
TTS_ENABLED=true

# piper = neural local TTS (best quality; needs a downloaded voice)
# sapi  = the operating system's own voice (robotic, but always available)
# auto  = prefer piper, fall back to sapi  <- recommended
TTS_ENGINE=auto

# Voice file name without the .onnx extension, inside backend/data/models/piper/
# Download with:  python scripts/download_speech_models.py
TTS_VOICE=en_US-amy-medium
TTS_SPEED=1.0
TTS_SAMPLE_RATE=22050


# -----------------------------------------------------------------------------
# LIVE JOB POSTING COLLECTION  (Module 2)
# -----------------------------------------------------------------------------
SCRAPE_ENABLED=true
SCRAPE_TIMEOUT_SECONDS=20
SCRAPE_MAX_POSTINGS=24
SCRAPE_PER_SOURCE_LIMIT=10

# Politeness: minimum seconds between two requests to the SAME host.
# robots.txt crawl-delay is honoured too, whichever is longer.
SCRAPE_MIN_INTERVAL_SECONDS=1.2

# Cached responses are reused for this long (6 hours), so repeating an analysis
# does not re-hit the source.
SCRAPE_CACHE_TTL_SECONDS=21600


# -----------------------------------------------------------------------------
# UPLOADS
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_SUFFIXES=.pdf,.docx,.txt
MAX_CV_CHARACTERS=60000


# -----------------------------------------------------------------------------
# INTERVIEW
# -----------------------------------------------------------------------------
INTERVIEW_MAX_TURNS=26

# How many previous turns are sent to the model as conversation history.
# Higher = better follow-ups, slower and more tokens.
INTERVIEW_HISTORY_TURNS=10


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
