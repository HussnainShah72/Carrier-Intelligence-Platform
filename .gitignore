# ---------------------------------------------------------------- secrets ----
# Never commit a real environment file. Only .env.example belongs in git.
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# ------------------------------------------------------------------ python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
dist/
build/
.ipynb_checkpoints/

# ------------------------------------------------------------------- node ----
node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ---------------------------------------------- runtime data (regenerated) ---
# The database holds uploaded CVs and interview transcripts: personal data that
# must not be committed. Models are large and re-downloadable.
backend/data/
!backend/data/.gitkeep

# ------------------------------------------------------------------ editors ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

